---
import Photo from "./Photo.astro";
import type { ImageMetadata } from "astro";

// Full-bleed photograph, trail name set large over the lower third, hairline,
// then the letterspaced location line. The book's opening move.
interface Props {
  photo: ImageMetadata;
  title: string;
  region: string;
  country: string;
  number: number;
}

const { photo, title, region, country, number } = Astro.props;
const index = String(number).padStart(2, "0");
---

<header class="opener">
  <Photo src={photo} sizes="100vw" priority class="opener__img" alt="" />
  <div class="opener__scrim"></div>
  <div class="opener__type page">
    <p class="label opener__number">Trail {index}</p>
    <h1 class="opener__title">{title}</h1>
    <hr class="opener__rule" />
    <p class="label opener__place">{region} &mdash; {country}</p>
  </div>
</header>

<style>
  .opener {
    position: relative;
    display: grid;
    isolation: isolate;
  }
  .opener > :global(*) {
    grid-area: 1 / 1;
  }
  .opener :global(.opener__img) {
    width: 100%;
    height: 100svh;
    object-fit: cover;
  }
  /* Only as much scrim as the type needs to stay legible. */
  .opener__scrim {
    background: linear-gradient(
      to top,
      rgb(12 11 10 / 0.62) 0%,
      rgb(12 11 10 / 0.28) 32%,
      rgb(12 11 10 / 0) 62%
    );
  }
  .opener__type {
    align-self: end;
    width: 100%;
    padding-bottom: clamp(2.5rem, 7vh, 6rem);
    color: var(--ink-invert);
  }
  .opener__number,
  .opener__place {
    color: rgb(247 245 240 / 0.78);
  }
  .opener__title {
    font-size: var(--step-4);
    margin: var(--space-xs) 0 var(--space-s);
    max-width: 14ch;
  }
  .opener__rule {
    border: 0;
    border-top: 1px solid rgb(247 245 240 / 0.4);
    width: min(100%, 22rem);
    margin: 0 0 var(--space-s);
  }
</style>
