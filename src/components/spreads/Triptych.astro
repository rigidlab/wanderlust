---
import Photo from "../Photo.astro";
import type { ImageMetadata } from "astro";

interface Props {
  photos: [ImageMetadata, ImageMetadata, ImageMetadata];
  caption?: string;
}

const { photos, caption } = Astro.props;
const [tall, upper, lower] = photos;
---

<figure class="spread triptych page">
  <div class="triptych__grid">
    <div class="triptych__cell triptych__cell--tall">
      <Photo src={tall} sizes="(max-width: 48rem) 100vw, 55vw" class="triptych__img" />
    </div>
    <div class="triptych__cell">
      <Photo src={upper} sizes="(max-width: 48rem) 100vw, 35vw" class="triptych__img" />
    </div>
    <div class="triptych__cell">
      <Photo src={lower} sizes="(max-width: 48rem) 100vw, 35vw" class="triptych__img" />
    </div>
  </div>
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .triptych {
    margin: 0;
  }
  /* One tall photograph holding the left, two stacked against it. */
  .triptych__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--gap-photo);
    aspect-ratio: 16 / 11;
  }
  .triptych__cell {
    overflow: hidden;
    min-height: 0;
  }
  .triptych__cell--tall {
    grid-row: span 2;
  }
  .triptych__cell :global(picture),
  .triptych :global(.triptych__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 48rem) {
    .triptych__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      aspect-ratio: auto;
    }
    .triptych__cell {
      aspect-ratio: 3 / 2;
    }
    .triptych__cell--tall {
      grid-row: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
