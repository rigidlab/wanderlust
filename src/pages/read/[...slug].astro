---
import { getCollection } from "astro:content";

// Book mode used to live here; it is now the default view at /trails/.
// Written as a page rather than an `astro.config` redirect because config
// redirects do not prefix their destination with `base`, which breaks on a
// project subpath deployment.
export async function getStaticPaths() {
  const trails = await getCollection("trails", ({ data }) => !data.draft);
  return trails.map((trail) => ({
    params: { slug: trail.id.replace(/\/index$/, "") },
    props: { slug: trail.id.replace(/\/index$/, "") },
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/trails/${slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body>
    <p>This page has moved. <a href={target}>Continue to the book</a>.</p>
  </body>
</html>
